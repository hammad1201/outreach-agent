# Secrets for one business. `init` copies this into your home folder as .env; never commit it.

# --- Discord: where drafts arrive for approval ---
# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_BOT_TOKEN=
# Right-click your private channel → Copy Channel ID (turn on Developer Mode in Discord settings first)
DISCORD_CHANNEL_ID=
# Right-click your own name → Copy User ID. Only this person can approve or send anything.
DISCORD_OWNER_ID=

# --- The mailbox that sends as [sender] email in config.toml ---
# The Google account you log into, and a Google app password for it
# (https://myaccount.google.com/apppasswords — needs 2-Step Verification on).
SMTP_USER=
SMTP_PASSWORD=
# Only if the inbox you read replies from differs from the account above:
# IMAP_USER=
# IMAP_PASSWORD=

# --- Only when [brain] provider = "api" ---
ANTHROPIC_API_KEY=

# --- Optional: finds and verifies named contacts (free plan: 25 lookups/month) ---
HUNTER_API_KEY=
